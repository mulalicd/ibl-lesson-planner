# .env.example — commit this. .env is never committed.
# Generated from actual usage found in the codebase (M-4: no invented vars).

# ── Frontend (Vite) — safe to expose in the client bundle ──
VITE_SUPABASE_URL=your_supabase_project_url_here
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key_here

# ── Backend (Supabase Edge Function secrets, set via `supabase secrets set`) ──
# NEVER put these in a VITE_ variable or the client bundle (E-4).
# Gemini key rotation: supabase/functions/ibl-chat/index.ts reads
# GEMINI_KEY_1 through GEMINI_KEY_8 and round-robins across whichever
# are set. At least one is required.
GEMINI_KEY_1=your_gemini_api_key_here
GEMINI_KEY_2=
GEMINI_KEY_3=
GEMINI_KEY_4=
GEMINI_KEY_5=
GEMINI_KEY_6=
GEMINI_KEY_7=
GEMINI_KEY_8=
